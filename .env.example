# Supabase. The publishable key is meant to be public — row-level security is
# what restricts it, not secrecy.
NEXT_PUBLIC_SUPABASE_URL=https://vcrzauuxvgpsbforiszz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Where product photos come from. Defaults to 'bucket' (Supabase Storage),
# verified 2026-09-06 as holding all 1,808 objects. Set to 'legacy' to fall
# back to the origin that served them before.
NEXT_PUBLIC_IMAGE_SOURCE=bucket

# The five PIN test accounts. Off in production: the sign-in screen used to
# print customer phone numbers where anyone could read them.
NEXT_PUBLIC_ENABLE_TEST_NUMBERS=0

# Server only. Bypasses row-level security completely — may be read by the
# cron routes and the push sender, and by nothing else.
SUPABASE_SECRET_KEY=
CRON_SECRET=

# Web push. Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:office@example.com
